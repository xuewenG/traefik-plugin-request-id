{
  "image": "mcr.microsoft.com/devcontainers/go:1.27-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1.7": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "golang.go"
      ]
    }
  },
  "postCreateCommand": "npm install -g @openai/codex",
  "remoteUser": "root",
  "runArgs": [
    "--security-opt=apparmor=unconfined"
  ],
  "containerEnv": {
    "TZ": "Asia/Shanghai"
  },
  "mounts": [
    "source=${localEnv:HOME}/.codex,target=/root/.codex,type=bind,consistency=cached"
  ]
}
